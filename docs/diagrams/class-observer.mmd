classDiagram
  direction TB
  class IncidentEvent {
    <<record>>
    IncidentEventType type
    Incident incident
    String actor
    IncidentStatus previousStatus
    IncidentStatus newStatus
    String description
    LocalDateTime occurredAt
  }
  class IncidentObserver {
    <<interface>>
    +onIncidentEvent(event)
  }
  class IncidentEventBus {
    -List~IncidentObserver~ observers
    +publish(event)
    +subscribe(observer)
    +unsubscribe(observer)
  }
  class AuditObserver {
    writes AuditRecord
  }
  class NotificationObserver {
    routes to recipients and channels
  }
  class DashboardBroadcastObserver {
    pushes to /topic/incidents
  }
  IncidentObserver <|.. AuditObserver
  IncidentObserver <|.. NotificationObserver
  IncidentObserver <|.. DashboardBroadcastObserver
  IncidentEventBus o-- "0..*" IncidentObserver
  IncidentEventBus ..> IncidentEvent : publishes
  class IncidentService
  class SLAMonitor {
    +tick()
  }
  IncidentService ..> IncidentEventBus : publish
  SLAMonitor ..> IncidentEventBus : publish SLA_WARNING, SLA_VIOLATED, ESCALATED

  class NotificationFactory {
    <<factory>>
    +forEvent(event)$ Message
  }
  class NotificationDispatcher {
    -Map~Type,NotificationChannel~ channels
    +send(user, msg, incidentId, type, channels...)
  }
  class NotificationChannel {
    <<interface>>
    +type() NotificationChannelType
    +compose(user, subject, body, incidentId, event) Notification
    +deliver(notification)
  }
  class EmailNotificationChannel {
    <<adapter>>
    
  }
  class SmsNotificationChannel {
    simulated
  }
  class InAppNotificationChannel {
    persists + WebSocket push
  }
  class EmailGateway {
    <<interface>>
    +sendEmail(to, subject, body)
  }
  class SimulatedEmailGateway {
    in-memory outbox
  }
  NotificationObserver ..> NotificationFactory : builds message
  NotificationObserver ..> NotificationDispatcher
  NotificationDispatcher o-- NotificationChannel
  NotificationChannel <|.. EmailNotificationChannel
  NotificationChannel <|.. SmsNotificationChannel
  NotificationChannel <|.. InAppNotificationChannel
  EmailNotificationChannel --> EmailGateway : adapts
  EmailGateway <|.. SimulatedEmailGateway
  class UserFactory {
    <<factory>>
    +create(request, skills) User
  }
  class AdminService
  AdminService ..> UserFactory
