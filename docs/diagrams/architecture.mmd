flowchart TB
  UI["Browser — React SPA (Vite)\nPages for each role: Report a problem · My incidents · My queue · Incident detail\nLive dashboard · Incidents · Reports · People · Settings · Audit log\nSTOMP WebSocket client for live updates"]
  subgraph Backend["Spring Boot backend"]
    SEC["Security\nJWT filter · BCrypt · role rules"]
    CTRL["REST controllers\nAuth · Incident · Catalog · Admin · AI\n+ GlobalExceptionHandler (uniform JSON errors)"]
    SVC["Application services\nIncident · Assignment · SLA · Admin · Report · Auth"]
    DOM["Domain model + intelligence\nIncident aggregate · State and Strategy patterns\nduplicate detection · category and resolution suggestion"]
    MON["SLAMonitor @Scheduled\nwarnings · violations · auto-escalation"]
    BUS["IncidentEventBus\nObserver pattern"]
    OBS["Observers\nAuditObserver · NotificationObserver → Email adapter / SMS / In-app\nDashboardBroadcastObserver"]
    REPO["Repositories\nSpring Data JPA + Specifications"]
    WSB["STOMP broker /topic\npushes live updates to every open browser\n(/topic/incidents · /topic/user/{id})"]
    subgraph AI["AI assistance (optional)"]
      AIF["AI feature services\nScreenshotTriage · ChatReporting · PlainEnglishSearch · ManagerSummary\nPlainLanguageUpdateService (after commit, background thread)\neach falls back to its own rules method"]
      AIS["AiModeService\nlive or rules mode · daily limit · cool-down"]
      GW["AiGateway port — Adapter\nClaudeAiGateway over the Anthropic Java SDK · fake in tests"]
    end
  end
  DB[("PostgreSQL 16\n9 tables")]
  CLAUDE(["Claude API — Anthropic (optional)\nClaude Sonnet 5.5"])
  UI -- "HTTPS /api/** (JSON + Bearer JWT)" --> SEC --> CTRL --> SVC
  SVC --> DOM
  SVC --> REPO --> DB
  SVC --> BUS
  MON --> BUS
  BUS --> OBS
  OBS --> REPO
  OBS --> WSB
  CTRL --> AIF
  OBS -- "saved in-app rows" --> AIF
  AIF --> AIS --> GW
  GW -.->|"HTTPS, only when AI is live"| CLAUDE
